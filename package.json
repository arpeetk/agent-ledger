{
  "name": "agent-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Policy-gated tool execution for AI agents, with approvals, verification, and signed action receipts.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "demo": "npm run start -w apps/demo-agent",
    "demo:sdk": "npm run start:sdk -w apps/demo-agent",
    "build": "npm run build -ws --if-present",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{ts,tsx,json,yaml,yml,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,yaml,yml,md}\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "npm run db:push -w apps/server",
    "db:studio": "npm run db:studio -w apps/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.56.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
