{
  "name": "@agent-ledger/adapter-vercel-ai",
  "version": "0.1.0",
  "description": "Vercel AI SDK adapter for Agent Ledger — add policy-gated execution to any Vercel AI tool.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@agent-ledger/sdk": "*"
  },
  "peerDependencies": {
    "ai": ">=3.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": false
    },
    "zod": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "ai": "^4.3.0",
    "zod": "^3.23.0",
    "typescript": "^5.4.0"
  },
  "license": "Apache-2.0",
  "keywords": [
    "agent-ledger",
    "vercel-ai",
    "ai-sdk",
    "tool-use",
    "policy"
  ]
}
