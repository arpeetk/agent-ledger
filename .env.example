# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=3001

# Signing key (auto-generated on first run if not set)
# SIGNING_PRIVATE_KEY=
# SIGNING_PUBLIC_KEY=

# Webhooks (optional, up to 5)
# Simple single webhook:
# WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# WEBHOOK_SECRET=your-secret-for-hmac-verification

# Multiple webhooks:
# WEBHOOK_URL_1=https://hooks.slack.com/services/...
# WEBHOOK_SECRET_1=slack-secret
# WEBHOOK_EVENTS_1=receipt.pending_approval,receipt.denied
#
# WEBHOOK_URL_2=https://your-app.com/webhooks/ledger
# WEBHOOK_SECRET_2=app-secret
# WEBHOOK_EVENTS_2=receipt.executed,receipt.approved
